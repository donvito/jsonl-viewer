{
  "name": "jsonl-viewer",
  "version": "1.3.3",
  "description": "A desktop Electron app for viewing and inspecting JSONL files",
  "main": "src/main.js",
  "desktopName": "jsonl-viewer.desktop",
  "homepage": "https://github.com/donvito/jsonl-viewer",
  "repository": {
    "type": "git",
    "url": "https://github.com/donvito/jsonl-viewer.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/test-parse.js && node test/test-traces.js && node test/test-stream.js",
    "icon": "rsvg-convert -w 1024 -h 1024 build/icon.svg -o build/icon.png",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "jsonl",
    "viewer",
    "electron",
    "json"
  ],
  "author": {
    "name": "Melvin Vivas",
    "email": "melvindave@gmail.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
